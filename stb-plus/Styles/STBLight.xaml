<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- STB 象牙白（浅色）浮动栏配色：暖白底 + 石墨文字 + 暖灰描边 -->
    <SolidColorBrush x:Key="FloatBarBackground" Color="#F2FBFAF7" />
    <SolidColorBrush x:Key="FloatBarBorderBrush" Color="#BFB9B09D" />
    <SolidColorBrush x:Key="FloatBarForeground" Color="#FF33322F" />
    <Color x:Key="FloatBarForegroundColor">#FF33322F</Color>
</ResourceDictionary>
