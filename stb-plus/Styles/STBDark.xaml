<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- STB 石墨（深色 / 黑板模式）浮动栏配色：近黑底 + 浅墨文字 + 钢灰描边 -->
    <SolidColorBrush x:Key="FloatBarBackground" Color="#F212171E" />
    <SolidColorBrush x:Key="FloatBarBorderBrush" Color="#BF4A5560" />
    <SolidColorBrush x:Key="FloatBarForeground" Color="#FFE8EBEF" />
    <Color x:Key="FloatBarForegroundColor">#FFE8EBEF</Color>
</ResourceDictionary>
