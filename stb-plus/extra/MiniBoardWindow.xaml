<Window x:Class="InkCanvasPlus.MiniBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="板中板 · STB"
        Width="480" Height="360"
        MinWidth="280" MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MBBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFE8EBEF" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MBBtnBg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MBBtnBg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MBBtnBg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MBDot" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        <Border x:Name="RootBorder" Margin="6" CornerRadius="12"
                Background="#FF101A16" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid>
                <InkCanvas x:Name="MiniInkCanvas" Background="Transparent" EditingMode="Ink" />

                <Border x:Name="HeaderBar" Height="30" VerticalAlignment="Top"
                        Background="#14000000" CornerRadius="12,12,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="TextBlockMiniBoardStatus"
                                   Text="板中板 · 黑板"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="#B3E8EBEF" />
                        <Button x:Name="BtnMBClose" Content="✕" Width="28" Height="24"
                                HorizontalAlignment="Right" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                FontSize="12" Foreground="#B3E8EBEF" Click="BtnMBClose_Click" />
                    </Grid>
                </Border>

                <Border x:Name="ToolBar" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="8" Padding="8,4" CornerRadius="14"
                        Background="#CC171E1A" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="BtnMBInkBlack" Style="{StaticResource MBDot}" Background="#FF101010" Margin="0,4,4,4" Click="BtnMBInkBlack_Click" ToolTip="黑笔" />
                        <Button x:Name="BtnMBInkRed" Style="{StaticResource MBDot}" Background="#FFD32F2F" Margin="0,4,8,4" Click="BtnMBInkRed_Click" ToolTip="红笔" />
                        <Button x:Name="BtnMBInkBlue" Style="{StaticResource MBDot}" Background="#FF1F6FC4" Margin="0,4,4,4" Click="BtnMBInkBlue_Click" ToolTip="蓝笔" />
                        <Button x:Name="BtnMBInkWhite" Style="{StaticResource MBDot}" Background="#FFFFFFFF" Margin="0,4,10,4" Click="BtnMBInkWhite_Click" ToolTip="白笔" />
                        <Button x:Name="BtnMBInk" Style="{StaticResource MBBtn}" Click="BtnMBInk_Click" ToolTip="书写">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Edit" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="笔" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMBEraser" Style="{StaticResource MBBtn}" Click="BtnMBEraser_Click" ToolTip="橡皮">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Remove" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="橡皮" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMBClear" Style="{StaticResource MBBtn}" Click="BtnMBClear_Click" ToolTip="清空">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="清空" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMBBg" Style="{StaticResource MBBtn}" Click="BtnMBBg_Click" ToolTip="白板 / 黑板">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Refresh" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="板色" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="#33FFFFFF" Margin="6,3,6,3" />
                        <Button x:Name="BtnMBWidthDown" Style="{StaticResource MBBtn}" Width="22" Click="BtnMBWidthDown_Click" ToolTip="画笔细一档（与主界面一致：1–20 档，每档 0.5 磅）">
                            <TextBlock Text="－" FontSize="12" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                        <TextBlock x:Name="TextBlockMBWidth" Text="5" FontSize="12" Width="18"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFE8EBEF" ToolTip="画笔档位（实际笔宽 = 档位 ÷ 2）" />
                        <Button x:Name="BtnMBWidthUp" Style="{StaticResource MBBtn}" Width="22" Click="BtnMBWidthUp_Click" ToolTip="画笔粗一档（与主界面一致：1–20 档，每档 0.5 磅）">
                            <TextBlock Text="＋" FontSize="12" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                        <Border Width="1" Background="#33FFFFFF" Margin="6,3,6,3" />
                        <Button x:Name="BtnMBSizeS" Style="{StaticResource MBBtn}" Click="BtnMBSizeS_Click" ToolTip="窗口尺寸：小">
                            <TextBlock Text="窗小" FontSize="9" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                        <Button x:Name="BtnMBSizeM" Style="{StaticResource MBBtn}" Click="BtnMBSizeM_Click" ToolTip="窗口尺寸：中">
                            <TextBlock Text="窗中" FontSize="9" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                        <Button x:Name="BtnMBSizeL" Style="{StaticResource MBBtn}" Click="BtnMBSizeL_Click" ToolTip="窗口尺寸：大">
                            <TextBlock Text="窗大" FontSize="9" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
