<Window x:Class="InkCanvasPlus.MiniBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="板中板 · STB"
        Width="480" Height="360"
        MinWidth="280" MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MBBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFE8EBEF" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MBBtnBg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MBBtnBg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MBBtnBg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MBBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MBBarBtnBg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MBBarBtnBg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MBBarBtnBg" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MBDot" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        <Border x:Name="RootBorder" Margin="6" CornerRadius="12"
                Background="#FF101A16" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid>
                <InkCanvas x:Name="MiniInkCanvas" Background="Transparent" EditingMode="Ink" />

                <Border x:Name="ToolBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8" Padding="8,4" CornerRadius="14"
                        Background="#CC171E1A" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="BtnMBInkBlack" Style="{StaticResource MBDot}" Background="#FF101010" Margin="0,4,4,4" Click="BtnMBInkBlack_Click" ToolTip="黑笔" />
                        <Button x:Name="BtnMBInkRed" Style="{StaticResource MBDot}" Background="#FFD32F2F" Margin="0,4,8,4" Click="BtnMBInkRed_Click" ToolTip="红笔" />
                        <Button x:Name="BtnMBInkBlue" Style="{StaticResource MBDot}" Background="#FF1F6FC4" Margin="0,4,4,4" Click="BtnMBInkBlue_Click" ToolTip="蓝笔" />
                        <Button x:Name="BtnMBInkWhite" Style="{StaticResource MBDot}" Background="#FFFFFFFF" Margin="0,4,10,4" Click="BtnMBInkWhite_Click" ToolTip="白笔" />
                        <Button x:Name="BtnMBInk" Style="{StaticResource MBBtn}" Click="BtnMBInk_Click" ToolTip="书写">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Edit" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="笔" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMBEraser" Style="{StaticResource MBBtn}" Click="BtnMBEraser_Click" ToolTip="橡皮">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Remove" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="橡皮" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMBClear" Style="{StaticResource MBBtn}" Click="BtnMBClear_Click" ToolTip="清空">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="清空" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMBBg" Style="{StaticResource MBBtn}" Click="BtnMBBg_Click" ToolTip="白板 / 黑板">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Refresh" Foreground="#FFE8EBEF" />
                                </Viewbox>
                                <TextBlock Text="板色" FontSize="8" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="#33FFFFFF" Margin="6,3,6,3" />
                        <Button x:Name="BtnMBWidthDown" Style="{StaticResource MBBtn}" Width="22" Click="BtnMBWidthDown_Click" ToolTip="画笔细一档（与主界面一致：1–20 档，每档 0.5 磅）">
                            <TextBlock Text="－" FontSize="12" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                        <TextBlock x:Name="TextBlockMBWidth" Text="5" FontSize="12" Width="18"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFE8EBEF" ToolTip="画笔档位（实际笔宽 = 档位 ÷ 2）" />
                        <Button x:Name="BtnMBWidthUp" Style="{StaticResource MBBtn}" Width="22" Click="BtnMBWidthUp_Click" ToolTip="画笔粗一档（与主界面一致：1–20 档，每档 0.5 磅）">
                            <TextBlock Text="＋" FontSize="12" HorizontalAlignment="Center" Foreground="#FFE8EBEF" />
                        </Button>
                    </WrapPanel>
                </Border>

                <Border x:Name="HeaderBar" Height="30" VerticalAlignment="Bottom"
                        Background="#CC171E1A" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0"
                        CornerRadius="0,0,12,12"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid>
                        <StackPanel x:Name="GripBar" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="8,0,0,0" Cursor="SizeAll"
                                    ToolTip="拖动此条移动板中板，双击可放大或还原">
                            <StackPanel Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="3" Height="3" Margin="0,0,2,2" Opacity="0.75"
                                             Fill="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}" />
                                    <Ellipse Width="3" Height="3" Margin="0,0,2,2" Opacity="0.75"
                                             Fill="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}" />
                                    <Ellipse Width="3" Height="3" Margin="0,0,0,2" Opacity="0.75"
                                             Fill="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="3" Height="3" Margin="0,0,2,0" Opacity="0.75"
                                             Fill="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}" />
                                    <Ellipse Width="3" Height="3" Margin="0,0,2,0" Opacity="0.75"
                                             Fill="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}" />
                                    <Ellipse Width="3" Height="3" Margin="0,0,0,0" Opacity="0.75"
                                             Fill="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TextBlockMiniBoardStatus"
                                       Text="板中板 · 黑板"
                                       VerticalAlignment="Center"
                                       FontSize="12" Foreground="#FFE8EBEF" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button x:Name="BtnMBCollapse" Style="{StaticResource MBBarBtn}"
                                    Click="BtnMBCollapse_Click"
                                    ToolTip="收起成一条，只留拖拽条">
                                <TextBlock x:Name="TextBlockMBCollapse" Text="▴" FontSize="11"
                                           Foreground="#FFE8EBEF" />
                            </Button>
                            <Button x:Name="BtnMBSizeCycle" Style="{StaticResource MBBarBtn}"
                                    Click="BtnMBSizeCycle_Click" ToolTip="在窗小 / 窗中 / 窗大之间切换">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="FullScreen" Foreground="#FFE8EBEF" />
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnMBClose" Style="{StaticResource MBBarBtn}"
                                    Click="BtnMBClose_Click" ToolTip="关闭板中板">
                                <TextBlock x:Name="TextBlockMBClose" Text="✕" FontSize="11"
                                           Foreground="#FFE8EBEF" />
                            </Button>
                            <Border x:Name="ResizeCorner" Width="16" Height="16" Margin="2,0,0,0"
                                    Background="Transparent" Cursor="SizeNWSE"
                                    ToolTip="拖动此角自由调整板中板大小"
                                    MouseLeftButtonDown="ResizeCorner_MouseLeftButtonDown"
                                    MouseLeftButtonUp="ResizeCorner_MouseLeftButtonUp">
                                <Path x:Name="PathResizeCorner" Stretch="None" Opacity="0.85"
                                      Stroke="{Binding ElementName=TextBlockMiniBoardStatus, Path=Foreground}"
                                      StrokeThickness="1">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="14,4" EndPoint="4,14" />
                                            <LineGeometry StartPoint="14,9" EndPoint="9,14" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
