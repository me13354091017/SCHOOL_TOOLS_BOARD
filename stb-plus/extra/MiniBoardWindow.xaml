<Window x:Class="InkCanvasPlus.MiniBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="板中板 · STB"
        Width="480" Height="360"
        MinWidth="260" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True">
    <Border x:Name="RootBorder" CornerRadius="12" Background="#FBFAF7"
            BorderBrush="#B9B09D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#EDEAE2" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TextBlockMiniBoardStatus"
                               Text="板中板 · STB（白板）"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="#33322F" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="BtnMBClose" Content="✕" Width="26" Height="24"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                FontSize="12" Click="BtnMBClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <InkCanvas x:Name="MiniInkCanvas" Grid.Row="1" Background="White" EditingMode="Ink" />

            <Border Grid.Row="2" Background="#F5F3EE" CornerRadius="0,0,12,12" Padding="8,5">
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="BtnMBInkBlack" Content="黑" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBInkBlack_Click" />
                    <Button x:Name="BtnMBInkRed" Content="红" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBInkRed_Click" />
                    <Button x:Name="BtnMBInkBlue" Content="蓝" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBInkBlue_Click" />
                    <Button x:Name="BtnMBInkWhite" Content="白" Width="28" Height="24" Padding="0" Margin="0,0,10,0" FontSize="12" Click="BtnMBInkWhite_Click" />
                    <Button x:Name="BtnMBThin" Content="细" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBThin_Click" />
                    <Button x:Name="BtnMBMedium" Content="中" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBMedium_Click" />
                    <Button x:Name="BtnMBThick" Content="粗" Width="28" Height="24" Padding="0" Margin="0,0,10,0" FontSize="12" Click="BtnMBThick_Click" />
                    <Button x:Name="BtnMBEraser" Content="橡皮" Width="44" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBEraser_Click" />
                    <Button x:Name="BtnMBInk" Content="笔" Width="32" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBInk_Click" />
                    <Button x:Name="BtnMBClear" Content="清空" Width="44" Height="24" Padding="0" Margin="0,0,10,0" FontSize="12" Click="BtnMBClear_Click" />
                    <Button x:Name="BtnMBBg" Content="白/黑板" Width="60" Height="24" Padding="0" Margin="0,0,10,0" FontSize="12" Click="BtnMBBg_Click" />
                    <Button x:Name="BtnMBSizeS" Content="小" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBSizeS_Click" />
                    <Button x:Name="BtnMBSizeM" Content="中" Width="28" Height="24" Padding="0" Margin="0,0,4,0" FontSize="12" Click="BtnMBSizeM_Click" />
                    <Button x:Name="BtnMBSizeL" Content="大" Width="28" Height="24" Padding="0" FontSize="12" Click="BtnMBSizeL_Click" />
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
