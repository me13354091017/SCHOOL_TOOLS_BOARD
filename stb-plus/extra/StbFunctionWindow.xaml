<Window x:Class="InkCanvasPlus.StbFunctionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InkCanvasPlus"
        Title="插入函数 · SchoolToolsBoard"
        Width="1020" Height="640" MinWidth="900" MinHeight="560"
        Background="#FFF7F8FA" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged" Loaded="Window_LoadedFunc">
    <Window.Resources>
        <Style x:Key="CatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE3E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE3E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock Text="函数类型" FontSize="13" FontWeight="SemiBold" Foreground="#FF1F2329" Margin="0,0,0,10" />
            <Button x:Name="BtnCat1" Style="{StaticResource CatButton}" Content="一次函数" Tag="y=x" Click="BtnCat_Click" />
            <Button x:Name="BtnCat2" Style="{StaticResource CatButton}" Content="二次函数" Tag="y=x^2" Click="BtnCat_Click" />
            <Button x:Name="BtnCat3" Style="{StaticResource CatButton}" Content="幂函数" Tag="y=x^3" Click="BtnCat_Click" />
            <Button x:Name="BtnCat4" Style="{StaticResource CatButton}" Content="指数函数" Tag="y=2^x" Click="BtnCat_Click" />
            <Button x:Name="BtnCat5" Style="{StaticResource CatButton}" Content="对数函数" Tag="y=log2(x)" Click="BtnCat_Click" />
            <Button x:Name="BtnCat6" Style="{StaticResource CatButton}" Content="三角函数" Tag="y=sin(x)" Click="BtnCat_Click" />
            <TextBlock Text="支持写法：x、pi、e、+ - * /、x² x³、√( ) 括号里继续输入、sin cos tan、ln lg log2、abs、空心圆点 ○；滚轮缩放、按住拖动平移"
                       FontSize="10" Foreground="#FF8A909A" TextWrapping="Wrap" Margin="2,6,0,0" />
        </StackPanel>

        <Grid Grid.Column="1">
            <Border Background="#FFFFFFFF" BorderBrush="#FFE3E6EC" BorderThickness="1" CornerRadius="10">
                <local:StbFuncPlot x:Name="Plot" Margin="10" MinWidth="360" MinHeight="300" />
            </Border>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <Button x:Name="BtnZoomIn" Content="＋" Width="32" Height="30" FontSize="16" Margin="0,0,0,6"
                        ToolTip="放大（也可滚轮向上）" Click="StbZoomIn_Click" />
                <Button x:Name="BtnZoomOut" Content="－" Width="32" Height="30" FontSize="16" Margin="0,0,0,6"
                        ToolTip="缩小（也可滚轮向下）" Click="StbZoomOut_Click" />
                <Button x:Name="BtnZoomReset" Content="⟲" Width="32" Height="30" FontSize="14"
                        ToolTip="还原视图" Click="StbZoomReset_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="2" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="表达式" FontSize="13" FontWeight="SemiBold" Foreground="#FF1F2329" Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelExpr" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="BtnAddExpr" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                        Content="+ 增加表达式" Click="BtnAddExpr_Click" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextExprCount" Grid.Column="0" FontSize="11" Foreground="#FF8A909A" VerticalAlignment="Center" />
                    <Button x:Name="BtnToggleKeypad" Grid.Column="1" Content="⌨ 快捷输入" FontSize="11" Padding="8,3"
                            Background="#FFFFFFFF" BorderBrush="#FFE3E6EC" BorderThickness="1" Cursor="Hand"
                            Click="BtnToggleKeypad_Click" />
                </Grid>
                <Border x:Name="PreviewHost" Background="#FFF8FAFC" BorderBrush="#FFE3E6EC" BorderThickness="1"
                        CornerRadius="8" Padding="10,6,10,6" Margin="0,0,0,8" MinHeight="34" />
                <TextBlock x:Name="TextHint" FontSize="11" Foreground="#FFD93025" TextWrapping="Wrap"
                           Margin="2,0,0,8" Visibility="Collapsed" />
                <Button x:Name="BtnInsert" Content="插入函数" Height="38" Background="#FF1F8F5F" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="BtnInsert_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
