<Window x:Class="InkCanvasPlus.StbFunctionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InkCanvasPlus"
        Title="插入函数 · SchoolToolsBoard"
        Width="1020" Height="640" MinWidth="900" MinHeight="560"
        Background="#FFF7F8FA" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged" Loaded="Window_LoadedFunc">
    <Window.Resources>
        <Style x:Key="CatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE3E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE3E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <Button x:Name="BtnCat1" Style="{StaticResource CatButton}" Tag="y=x" Click="BtnCat_Click">
                <StackPanel>
                    <Path Data="M2,17 H42 M22,2 V32 M6,29 L38,5" Stroke="#FF9AA1AB" StrokeThickness="1.2" Width="44" Height="30" Stretch="Uniform" Margin="0,0,0,4" />
                    <TextBlock Text="一次函数" FontSize="12" Foreground="#FF1F2329" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCat2" Style="{StaticResource CatButton}" Tag="y=x^2" Click="BtnCat_Click">
                <StackPanel>
                    <Path Data="M2,17 H42 M22,2 V32 M8,6 Q22,34 36,6" Stroke="#FF9AA1AB" StrokeThickness="1.2" Width="44" Height="30" Stretch="Uniform" Margin="0,0,0,4" />
                    <TextBlock Text="二次函数" FontSize="12" Foreground="#FF1F2329" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCat3" Style="{StaticResource CatButton}" Tag="y=x^-1" Click="BtnCat_Click">
                <StackPanel>
                    <Path Data="M2,17 H42 M22,2 V32 M24,3 C26,11 30,15 41,16 M3,18 C14,19 18,23 20,31" Stroke="#FF9AA1AB" StrokeThickness="1.2" Width="44" Height="30" Stretch="Uniform" Margin="0,0,0,4" />
                    <TextBlock Text="幂函数" FontSize="12" Foreground="#FF1F2329" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCat4" Style="{StaticResource CatButton}" Tag="y=2^x" Click="BtnCat_Click">
                <StackPanel>
                    <Path Data="M2,17 H42 M22,2 V32 M3,26 C18,24 26,16 37,4" Stroke="#FF9AA1AB" StrokeThickness="1.2" Width="44" Height="30" Stretch="Uniform" Margin="0,0,0,4" />
                    <TextBlock Text="指数函数" FontSize="12" Foreground="#FF1F2329" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCat5" Style="{StaticResource CatButton}" Tag="y=log2(x)" Click="BtnCat_Click">
                <StackPanel>
                    <Path Data="M2,17 H42 M22,2 V32 M5,31 C9,19 17,13 41,9" Stroke="#FF9AA1AB" StrokeThickness="1.2" Width="44" Height="30" Stretch="Uniform" Margin="0,0,0,4" />
                    <TextBlock Text="对数函数" FontSize="12" Foreground="#FF1F2329" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCat6" Style="{StaticResource CatButton}" Tag="y=sin(x)" Click="BtnCat_Click">
                <StackPanel>
                    <Path Data="M2,17 H42 M22,2 V32 M3,17 C9,3 15,3 21,17 S33,31 41,17" Stroke="#FF9AA1AB" StrokeThickness="1.2" Width="44" Height="30" Stretch="Uniform" Margin="0,0,0,4" />
                    <TextBlock Text="三角函数" FontSize="12" Foreground="#FF1F2329" />
                </StackPanel>
            </Button>
            <TextBlock Text="左侧快捷选择或直接输入"
                       FontSize="10" Foreground="#FF8A909A" TextWrapping="Wrap" Margin="2,6,0,0" />
        </StackPanel>

        <Grid Grid.Column="1">
            <Border Background="#FFFFFFFF" BorderBrush="#FFE3E6EC" BorderThickness="1" CornerRadius="10">
                <local:StbFuncPlot x:Name="Plot" Margin="10" MinWidth="360" MinHeight="300" />
            </Border>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14">
                <Button x:Name="BtnZoomIn" Width="34" Height="32" Padding="0" Margin="0,0,0,6"
                        Background="Transparent" BorderBrush="#FFDDE1E8" BorderThickness="1" Cursor="Hand"
                        ToolTip="放大（也可滚轮向上）" Click="StbZoomIn_Click">
                    <Path Data="M8,0 V16 M0,8 H16" Stroke="#FF1F2329" StrokeThickness="1.8"
                          Width="14" Height="14" Stretch="Uniform" />
                </Button>
                <Button x:Name="BtnZoomOut" Width="34" Height="32" Padding="0" Margin="0,0,0,6"
                        Background="Transparent" BorderBrush="#FFDDE1E8" BorderThickness="1" Cursor="Hand"
                        ToolTip="缩小（也可滚轮向下）" Click="StbZoomOut_Click">
                    <Path Data="M0,8 H16" Stroke="#FF1F2329" StrokeThickness="1.8"
                          Width="14" Height="14" Stretch="Uniform" />
                </Button>
                <Button x:Name="BtnZoomReset" Width="34" Height="32" Padding="0"
                        Background="Transparent" BorderBrush="#FFDDE1E8" BorderThickness="1" Cursor="Hand"
                        ToolTip="还原视图" Click="StbZoomReset_Click">
                    <Path Data="M10,4 A5,5 0 1 0 10,14 M10,4 L10,1 M10,4 L7,4" Stroke="#FF1F2329" StrokeThickness="1.8"
                          Width="15" Height="15" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="2" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelExpr" />
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Button x:Name="BtnAddExpr" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                        Content="＋ 增加表达式" Click="BtnAddExpr_Click" Margin="0,0,0,8" />
                <TextBlock x:Name="TextExprCount" FontSize="11" Foreground="#FF8A909A" Margin="2,0,0,6" />
                <Border x:Name="PreviewHost" Background="#FFF8FAFC" BorderBrush="#FFE3E6EC" BorderThickness="1"
                        CornerRadius="8" Padding="10,6,10,6" Margin="0,0,0,8" MinHeight="34" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextHint" Grid.Column="0" FontSize="11" Foreground="#FFD93025" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="2,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="BtnInsert" Grid.Column="1" Content="插入函数" Width="120" Height="38" Background="#FF1F8F5F" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="BtnInsert_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>