<Window x:Class="InkCanvasPlus.StbComponentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="组件 · SchoolToolsBoard"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="560"
        Background="#FFF7F8FA"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE1E4EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF3A3F47" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,22,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="组件" FontSize="26" FontWeight="Bold" Foreground="#FF1F2329" />
                <TextBlock Text="以下组件将显示在主界面上，从组件库拖动组件以添加组件。"
                           FontSize="13" Foreground="#FF6B7280" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="配置方案" FontSize="12" Foreground="#FF6B7280" HorizontalAlignment="Right" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ComboScheme" Width="176" Height="32" SelectedIndex="0"
                              FontSize="13" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Default" />
                    </ComboBox>
                    <Button x:Name="BtnReload" Content="刷新" Style="{StaticResource PlainButton}"
                            Height="32" Margin="8,0,0,0" Click="BtnReload_Click" ToolTip="重新读取当前组件配置" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="26,22,26,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="当前组件" FontSize="14" FontWeight="SemiBold" Foreground="#FF1F2329" Margin="0,0,0,8" />
            <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE6E9EF" BorderThickness="1" CornerRadius="8"
                    MinHeight="120" MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="PanelActive" Margin="12,10" />
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="组件库" FontSize="14" FontWeight="SemiBold" Foreground="#FF1F2329"
                   Margin="26,18,26,8" />

        <Border Grid.Row="3" Margin="26,0,26,0" Background="#FFFFFFFF" BorderBrush="#FFE6E9EF"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="PanelLibrary" Margin="14,12" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Background="#FFF2F6FF" BorderBrush="#FFD9E5FF" BorderThickness="0,1,0,0" Padding="26,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="#FF2C6BED" VerticalAlignment="Center" />
                    <TextBlock Text="新功能：现在可以使用「编辑模式」更加直观地编辑主界面上的组件！"
                               FontSize="13" Foreground="#FF2C6BED" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="进入编辑模式" Style="{StaticResource PlainButton}"
                        Height="32" Padding="16,0" Click="BtnEditMode_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
