<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="InkBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="墨板 InkBoard · 课堂白板"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF1F5"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="OnDropFile">
  <Grid>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E5E8EC" BorderThickness="0,0,0,1" Padding="10,7">
        <StackPanel x:Name="TopBar" Orientation="Horizontal" VerticalAlignment="Center" />
      </Border>

      <Border DockPanel.Dock="Left" Width="118" Background="#FFFFFF" BorderBrush="#E5E8EC" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel x:Name="PageBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,8" />
          <Border DockPanel.Dock="Bottom" BorderBrush="#E5E8EC" BorderThickness="0,1,0,0" Padding="6,6">
            <StackPanel x:Name="RailFooter" Orientation="Vertical" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PageList" Margin="4" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E5E8EC" BorderThickness="0,1,0,0" Padding="8,5">
        <StackPanel x:Name="ToolBar" Orientation="Horizontal" VerticalAlignment="Center" />
      </Border>

      <Grid x:Name="BoardHost" ClipToBounds="True" Background="#EEF1F5" />
    </DockPanel>

    <!-- 聚光灯 -->
    <Grid x:Name="SpotLayer" Visibility="Collapsed" IsHitTestVisible="False">
      <Rectangle x:Name="SpotRect" />
    </Grid>

    <!-- 遮罩揭幕 -->
    <Border x:Name="Curtain" Visibility="Collapsed" VerticalAlignment="Top" Height="0"
            Background="#1F2937" Cursor="SizeNS" />

    <!-- 计时器 -->
    <Border x:Name="TimerChip" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,64,20,0" Padding="16,8" CornerRadius="10" Background="#E60B1220">
      <TextBlock x:Name="TimerText" Text="00:00" Foreground="#FFFFFF" FontSize="26" FontFamily="Consolas" />
    </Border>
  </Grid>
</Window>
