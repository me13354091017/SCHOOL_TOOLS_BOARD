<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SchoolToolsBoard</AssemblyName>
    <RootNamespace>InkBoard</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets/**" />
    <Resource Include="Assets/app.ico" Condition="Exists('Assets/app.ico')" />
  </ItemGroup>
</Project>
